### Bucket for agents offline for one hour ###

"aggs": {
  "0": {
    "terms": {
      "field": "data_stream.dataset",
      "order": { "2": "desc" },
      "size": 99
    },
    "aggs": {
      "1": {
        "terms": {
          "field": "agent.name",
          "order": { "2": "desc" },
          "size": 100
        },
        "aggs": {
          "2": {
            "max": { "field": "@timestamp" }
          },
          "offline_filter": {
            "bucket_selector": {
              "buckets_path": {
                "last_seen": "2"
              },
              "script": "params.last_seen <= Instant.now().minus(60, ChronoUnit.MINUTES).toEpochMilli()"
            }
          }
        }
      },
      "2": {
        "max": { "field": "@timestamp" }
      },
      "offline_filter": {
        "bucket_selector": {
          "buckets_path": {
            "last_seen": "2"
          },
          "script": "params.last_seen <= Instant.now().minus(60, ChronoUnit.MINUTES).toEpochMilli()"
        }
      }
    }
  }
