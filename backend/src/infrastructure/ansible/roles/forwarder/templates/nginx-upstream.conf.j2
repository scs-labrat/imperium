# Nginx Reverse Proxy Configuration
# Generated by Imperium C2

{% if upstream_servers | length > 0 %}
upstream backend_servers {
{% for server in upstream_servers %}
    server {{ server.host }}:{{ server.port }} weight={{ server.weight | default(1) }};
{% endfor %}
    keepalive 32;
}
{% endif %}

server {
    listen {{ listen_port }}{% if ssl_enabled %} ssl{% endif %};
    listen [::]:{{ listen_port }}{% if ssl_enabled %} ssl{% endif %};

{% if ssl_enabled %}
    ssl_certificate {{ ssl_cert_path }};
    ssl_certificate_key {{ ssl_key_path }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
{% endif %}

    # Logging
    access_log /var/log/nginx/forward-{{ listen_port }}-access.log;
    error_log /var/log/nginx/forward-{{ listen_port }}-error.log;

    # Timeouts
    proxy_connect_timeout 60s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;

    # Buffer settings
    proxy_buffer_size 128k;
    proxy_buffers 4 256k;
    proxy_busy_buffers_size 256k;

    location / {
{% if upstream_servers | length > 0 %}
        proxy_pass http://backend_servers;
{% else %}
        proxy_pass http://{{ target_host }}:{{ target_port }};
{% endif %}

        # Headers
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        # WebSocket support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Health check endpoint (return 200 for monitoring)
    location /health {
        access_log off;
        return 200 "OK\n";
        add_header Content-Type text/plain;
    }
}
