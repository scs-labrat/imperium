# Nebula Configuration
# Generated by Imperium C2

pki:
  ca: {{ nebula_config_dir }}/ca.crt
  cert: {{ nebula_config_dir }}/host.crt
  key: {{ nebula_config_dir }}/host.key

static_host_map:
{% for lighthouse in lighthouse_hosts %}
  "{{ lighthouse.overlay_ip }}": ["{{ lighthouse.public_ip }}:4242"]
{% endfor %}

lighthouse:
  am_lighthouse: {{ is_lighthouse | lower }}
  interval: 60
{% if not is_lighthouse %}
  hosts:
{% for lighthouse in lighthouse_hosts %}
    - "{{ lighthouse.overlay_ip }}"
{% endfor %}
{% endif %}

listen:
  host: 0.0.0.0
  port: 4242

punchy:
  punch: true
  respond: true

relay:
  am_relay: {{ is_lighthouse | lower }}
  use_relays: {{ (not is_lighthouse) | lower }}

tun:
  disabled: false
  dev: nebula1
  drop_local_broadcast: false
  drop_multicast: false
  tx_queue: 500
  mtu: 1300

logging:
  level: info
  format: text

firewall:
  conntrack:
    tcp_timeout: 12m
    udp_timeout: 3m
    default_timeout: 10m

  outbound:
    - port: any
      proto: any
      host: any

  inbound:
    - port: any
      proto: icmp
      host: any

    - port: any
      proto: any
      groups:
        - imperium
        - redirectors

    # Allow SSH from imperium group
    - port: 22
      proto: tcp
      groups:
        - imperium

    # Allow forwarding ports
    - port: 80
      proto: tcp
      host: any

    - port: 443
      proto: tcp
      host: any

    # Allow all traffic from C2 server
    - port: any
      proto: any
      groups:
        - c2-server
