generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SiemConfig {
  id           String  @id @default("default")
  url          String
  apiKey       String
  connected    Boolean
  verifyTls    Boolean @default(true)
  indexPattern String  @default("logs-*")
  cloudId      String?
}

model SiemRule {
  id          String  @id
  name        String
  description String
  query       String
  severity    String
  risk_score  Int
  enabled     Boolean
}

model McpConfig {
  id      String  @id @default("default")
  command String
  args    String
  enabled Boolean @default(true)
}

model LlmConfig {
  id        String  @id @default("default")
  provider  String
  model     String
  apiKey    String?
  isDefault Boolean @default(false)
}
